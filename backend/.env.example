# The backend reads these from the environment. For local work, either set them in PowerShell
#   $env:JWT_SECRET = "..."
# or copy this file to ".env" and load it yourself (for example `node --env-file=.env server.js`).
# NEVER commit a real ".env" to GitHub.

# Where MongoDB is. Local default shown. For MongoDB Atlas paste the connection string it gives you.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_electric_meter

# A long random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only needed in production: the exact web addresses of the two portals, comma-separated,
# no trailing slashes, e.g. https://zenplug-admin.netlify.app,https://zenplug-customer.netlify.app
CORS_ORIGINS=

# Shared secret the meter hardware sends as "Authorization: Bearer <token>". Required in production.
METER_INGEST_TOKEN=

PORT=3000

# Sri Lanka is UTC+5:30 = 330 minutes. Used for billing months and daily totals.
TZ_OFFSET_MINUTES=330

# Raw meter readings are deleted after this many days (bills are kept). 0 = keep everything.
READING_RETENTION_DAYS=90
